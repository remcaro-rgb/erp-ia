# Docker target (docker-compose.yml, design §21). `pnpm docker:env` copies this file to .env.docker (gitignored) and
# replaces every `generate` with a fresh local-only secret: a random database password, JWT secret and internal
# token, and the anon / service-role keys signed with that JWT secret. Never commit .env.docker, never reuse its
# values outside this stack. Then: `pnpm docker:up` (build, start, wait until healthy) and `pnpm docker:down`.

# ---- secrets (generated) ----
POSTGRES_PASSWORD=generate
# HS256 secret of Auth, PostgREST and Storage (at least 32 characters).
JWT_SECRET=generate
JWT_EXP=3600
# JWTs signed with JWT_SECRET: { role: "anon" } and { role: "service_role" }, issuer "supabase".
ANON_KEY=generate
SERVICE_ROLE_KEY=generate
# Auth's ES256 signing key (private JWK set) and the verification JWKS of PostgREST and Storage (public key + secret):
# user sessions are asymmetric JWTs the app verifies locally, as on Supabase cloud and with `supabase start`.
JWT_KEYS=generate
JWT_JWKS=generate
# Shared by the web app and the worker: the worker's x-internal-token on POST /api/internal/outbox/tick.
INTERNAL_TOKEN=generate

# ---- published ports (bound to 127.0.0.1; the Supabase CLI stack keeps 54322 / 55321) ----
DB_HOST_PORT=56322
KONG_HOST_PORT=56321
WEB_HOST_PORT=56300
MAIL_HOST_PORT=56324
WORKFLOW_WEB_HOST_PORT=56456

# ---- URLs seen from the browser ----
SITE_URL=http://127.0.0.1:56300
API_EXTERNAL_URL=http://127.0.0.1:56321

# ---- mail (Mailpit in the compose; a customer relay on-premise) ----
MAIL_FROM=erp@cafedelnorte.test

# ---- models (optional in phase 1): a self-hosted gateway such as LiteLLM; the model choice stays in kernel.model_policies ----
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
