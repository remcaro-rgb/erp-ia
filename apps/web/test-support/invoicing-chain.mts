// Test helper (e2e, plan 2B Task 20): the sale chain an invoice page starts from, run through the registered processes as the fixture's
// administrator (origin ui, a step-up token where the process asks for one), as the invoicing integration harness does: the accounting
// configured (the country's chart, its posting rules and the fiscal year, ledger started on January 1st), a cost center for the revenue
// line, the DIAN resolution of invoices and the numbering of credit and debit notes, the DIAN software registered (the submission is
// queued, not «Sin configurar»), two goods with stock and three customers ready to invoice, and one confirmed and shipped pedido per
// customer (the entregas sit in «Por facturar»). The fixture's roles are granted every process of those modules first. With `--issue <customer document>` the pedido of that customer is invoiced and issued
// too. Prints the ids as JSON. Task 24b: payments is loaded and granted too (the receipts pages start from issued invoices).
// `tsx test-support/invoicing-chain.mts <company id> <user id> [--issue <document number>]`
import { randomUUID } from "node:crypto";
import postgres from "postgres";
import { translate } from "@erp/i18n";
import { co } from "@erp/loc-co";
import { einvoicePack } from "@erp/loc-co/einvoice";
import { accounting } from "@erp/module-accounting";
import { core } from "@erp/module-core";
import { costing } from "@erp/module-costing";
import { crm } from "@erp/module-crm";
import { invoicing } from "@erp/module-invoicing";
import { inventory } from "@erp/module-inventory";
import { payments } from "@erp/module-payments";
import { warehouse as warehouseModule } from "@erp/module-warehouse";
import { sales } from "@erp/module-sales";
import { support } from "@erp/module-support";
import { kernelModule, loadModules, registerCatalogue, registerCountryPack, Registry, runProcess, syncRegistry, type Caller } from "@erp/kernel";
import { testEnv } from "./env";

const [companyId, userId, flag, issueFor] = process.argv.slice(2);
if (!companyId || !userId) throw new Error("usage: invoicing-chain.mts <company id> <user id> [--issue <document number>]");

const TECHNICAL_KEY = "fc8eac422eba16e22ffd8c6f94b3f40a6e38162c";
const CUSTOMERS = [
  { documentNumber: "860002964", legalName: "Distribuidora La Sabana S.A.S." },
  { documentNumber: "890903938", legalName: "Hotel Casa Andina S.A.S." },
  { documentNumber: "800197268", legalName: "Tienda El Maizal S.A.S." },
];

const sql = postgres(testEnv().DATABASE_URL, { max: 2, onnotice: () => {} });
try {
  const registry = new Registry();
  loadModules(registry, [kernelModule, core, accounting, support, inventory, costing, sales, crm, invoicing, payments, warehouseModule]);
  registerCountryPack({ ...co, einvoice: einvoicePack });
  registerCatalogue(translate);
  const [company] = await sql<{ tenant_id: string }[]>`select tenant_id from kernel.companies where id = ${companyId}`;
  const roles = await sql<{ id: string }[]>`
    select mr.role_id as id from kernel.membership_roles mr join kernel.memberships m on m.id = mr.membership_id where m.user_id = ${userId} and m.company_id = ${companyId}`;
  const caller: Caller = {
    claims: { sub: userId, tenant_id: company!.tenant_id, company_ids: [companyId], active_company_id: companyId, role_ids: roles.map((r) => r.id), locale: "es-419" },
    origin: "ui",
  };
  const run = <T = unknown,>(processId: string, input: unknown, stepUp = false): Promise<T> =>
    (async () => {
      if (!stepUp) return runProcess({ sql, registry }, caller, processId, input) as Promise<T>;
      const token = randomUUID();
      await sql`insert into kernel.step_up_verifications(user_id, company_id, token) values (${userId}, ${companyId}, ${token})`;
      return runProcess({ sql, registry }, { ...caller, stepUpToken: token }, processId, input) as Promise<T>;
    })();
  const ids: Record<string, unknown> = {};

  if (flag !== "--issue") {
    // The administrator may run every process of the modules the pages touch: their own grants are not what the invoicing spec is about.
    // Fix round 1: the loaded registry is synced first (the app does it at boot), so the grants are of the processes the database knows
    // (kernel.registered_processes: the manifests' declared processes, Por facturar's list among them); the typed lifecycle's generic
    // processes (Grabar, Eliminar of a documento) are generated by the kernel, never declared in a manifest, so they come from the registry.
    await syncRegistry(sql, registry);
    const modules = ["core", "accounting", "inventory", "costing", "sales", "crm", "invoicing", "payments", "kernel"];
    const declared = (await sql<{ process_id: string }[]>`select process_id from kernel.registered_processes where module_id = any(${modules}::text[])`).map((r) => r.process_id);
    const generic = registry.processes().map((p) => p.id).filter((id) => modules.includes(id.split(".")[0]!) && /\.(save|submit|approve|reject|delete|void)$/.test(id) && !declared.includes(id));
    for (const roleId of caller.claims.role_ids) {
      for (const id of [...declared, ...generic]) {
        await sql`insert into kernel.process_permissions(company_id, role_id, process_id) values (${companyId}, ${roleId}, ${id}) on conflict do nothing`;
      }
    }
    const year = Number((await sql<{ y: string }[]>`select extract(year from now() at time zone 'America/Bogota')::int::text as y`)[0]!.y);
    await sql`update kernel.companies set tax_id = '900373115' where id = ${companyId}`;
    await run("accounting.chart.seed", {}, true);
    await sql`update accounting.settings set ledger_starts_on = ${`${year}-01-01`} where company_id = ${companyId}`;
    const [costCenter] = await sql<{ id: string }[]>`insert into accounting.cost_centers (company_id, code, name, kind) values (${companyId}, 'VTA', 'Ventas', 'leaf') returning id`;
    const resolution = { number: "18760000001", prefix: "FE", from: 1, to: 5000, validFrom: `${year}-01-01`, validTo: `${year + 1}-12-31`, technicalKey: TECHNICAL_KEY };
    await sql`insert into core.document_sequences(company_id, document_type, prefix, next_number, resolution) values (${companyId}, 'invoice', 'FE', 1, ${sql.json(resolution as never)})`;
    await sql`insert into core.document_sequences(company_id, document_type, prefix, next_number) values (${companyId}, 'credit_note', 'NC', 1), (${companyId}, 'debit_note', 'ND', 1)`;
    await run("invoicing.settings.update", {
      defaultCostCenterId: costCenter!.id, softwareId: "56f2ae4e-9812-4fad-9255-08fcfcd5ccb0", softwareProviderTaxId: "900373115",
      issuerTaxResponsibilities: ["O-13"], issuerDepartmentCode: "11", issuerMunicipalityCode: "11001",
    }, true);

    const parties: string[] = [];
    for (const c of CUSTOMERS) {
      const party = await run<{ id: string }>("core.party.create", {
        kind: ["customer"], personType: "1", documentType: "31", documentNumber: c.documentNumber, legalName: c.legalName, taxResponsibilities: ["O-13"], taxScheme: "01",
        countryCode: "CO", departmentCode: "11", municipalityCode: "11001", addressLine: "Cra 7 # 71-21", invoiceEmail: "fe@cliente.example",
      });
      // The files a company requires of a customer (RUT, Cámara de Comercio), as stored attachments: the customer is ready to invoice.
      for (const tag of ["RUT", "Cámara de Comercio"]) {
        await sql`insert into kernel.attachments (company_id, entity, record_id, tag, file_name, mime_type, size_bytes, storage_path)
          values (${companyId}, 'core.party', ${party.id}, ${tag}, ${`${tag}.pdf`}, 'application/pdf', 1024, ${`${company!.tenant_id}/${companyId}/core.party/${party.id}/${randomUUID()}.pdf`})`;
      }
      parties.push(party.id);
    }
    const product = await run<{ id: string }>("core.product.create", {
      sku: "FAC-CAF-500", description: "Café Origen Huila 500 g", kind: "good", idScheme: "999", uomCode: "94", ivaRate: "5", otherTaxes: [], listPrice: 28000, isFreeSample: false, trackStock: true,
    });
    const service = await run<{ id: string }>("core.product.create", {
      sku: "FAC-SRV-01", description: "Instalación de molino", kind: "service", idScheme: "999", uomCode: "94", ivaRate: "19", otherTaxes: [], listPrice: 50000, isFreeSample: false, trackStock: false,
    });
    const warehouseId = (await run<{ id: string }>("inventory.warehouse.create", { code: "PRIN", name: "Bodega Principal", allowBackorders: false })).id;
    const locationId = (await run<{ id: string }>("inventory.location.create", { warehouseId, code: "A1", name: "Estante A1" })).id;
    await run("inventory.movement.post", { kind: "receipt", date: `${year}-01-10`, warehouseId, lines: [{ productId: product.id, locationId, qty: 100, unitCost: 17400 }] });

    const orders: { orderId: string; orderNumber: string; deliveryId: string; deliveryNumber: string }[] = [];
    for (const partyId of parties) {
      const order = await run<{ id: string; number: string }>("sales.order.create", {
        partyId, warehouseId, lines: [{ productId: product.id, qty: 3, unitPrice: 28000 }, { productId: service.id, qty: 1, unitPrice: 50000 }],
      });
      await run("sales.order.confirm", { id: order.id });
      const delivery = await run<{ id: string; number: string }>("sales.delivery.create", { orderId: order.id, costCenterId: costCenter!.id });
      await run("sales.delivery.ship", { id: delivery.id });
      orders.push({ orderId: order.id, orderNumber: order.number, deliveryId: delivery.id, deliveryNumber: delivery.number });
    }
    Object.assign(ids, { parties, productId: product.id, serviceId: service.id, warehouseId, costCenterId: costCenter!.id, orders });
  } else {
    // The pedido of one customer invoiced («Por facturar») and issued («Emitir»), as the invoice page would.
    const [order] = await sql<{ id: string }[]>`
      select o.id from sales.orders o join core.parties p on p.id = o.party_id where o.company_id = ${companyId} and p.document_number = ${issueFor ?? ""}`;
    const created = await run<{ invoices: { id: string }[] }>("invoicing.invoice.from_orders", { orderIds: [order!.id] });
    const issued = await run<{ id: string; number: string }>("invoicing.invoice.issue", { id: created.invoices[0]!.id, idempotencyKey: randomUUID() });
    Object.assign(ids, { invoiceId: issued.id, number: issued.number });
  }
  console.log(JSON.stringify(ids));
} finally {
  await sql.end({ timeout: 5 });
}
process.exit(0);
