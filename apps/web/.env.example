# Copy to .env.local (gitignored). Since 2026-10-29 development runs against the owner's hosted Supabase project
# (design §22, option 1: hosted for development, the Docker stack stays in CI). Put the project's values here:
#   NEXT_PUBLIC_SUPABASE_URL      https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY the legacy "anon" JWT (Project Settings › API Keys › Legacy API keys)
#   SUPABASE_SERVICE_ROLE_KEY     the legacy "service_role" JWT (server-only, rule 12: never exposed to the browser)
#   SUPABASE_DB_PASSWORD          the database password (the scripts build the connection strings from it)
#   DATABASE_URL                  the session pooler (IPv4): postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   TEST_DATABASE_URL             the same URL; the integration suites use it
# The hosted project must have the access token hook enabled once (Authentication › Hooks › Customize Access Token
# Claims › Postgres function kernel.custom_access_token_hook); supabase/config.toml only configures the local stack.
# The demo seed on that project needs DEMO_SEED=1 and DEMO_SEED_REMOTE=1 (the demo passwords are public).
#
# The values below are the public demo keys of `supabase start`, for anyone who still runs the Docker stack locally;
# run `supabase status` to confirm them for your stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Server-only (rule 12): never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# The assistant's model. Set AI_GATEWAY_API_KEY to use the AI Gateway with the models of kernel.model_policies.
# Without a key, uncomment AGENT_MODEL=mock to run the turns with the AI SDK mock model, a test double that understands
# «busca el cliente …» and «crea el cliente …, NIT …» (a production server refuses it unless ALLOW_MOCK_MODEL=1).
AI_GATEWAY_API_KEY=
# AGENT_MODEL=mock
