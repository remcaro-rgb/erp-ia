{
  "event": "invoicing.note.issued",
  "name": "Nota crédito de anulación de venta",
  "journalCode": "VT",
  "template": {
    "date": "$.date",
    "description": "Nota {{number}} · {{customer.legalName}}",
    "party": "$.customer.partyId",
    "costCenter": "$.costCenterId",
    "source": {
      "entity": "invoicing.note",
      "id": "$.noteId"
    },
    "when": [
      {
        "path": "$.annulment",
        "equals": true
      }
    ],
    "lines": [
      {
        "role": "receivable",
        "side": "debit",
        "amount": "$.totals.total",
        "dueDate": "$.dueDate"
      },
      {
        "role": "revenue",
        "side": "credit",
        "forEach": "$.lines[*]",
        "amount": "$.subtotal",
        "dimension": "category:{{categoryId}}",
        "costCenter": "$.costCenterId"
      },
      {
        "role": "vat_out",
        "side": "credit",
        "forEach": "$.taxes[*]",
        "amount": "$.amount",
        "dimension": "tax:{{code}}",
        "taxCode": "$.code",
        "taxRate": "$.rate",
        "taxBase": "$.base"
      }
    ],
    "reverseOf": null
  }
}
