{
  "event": "costing.cogs.posted",
  "name": "Costo de ventas",
  "journalCode": "NC",
  "template": {
    "date": "$.date",
    "description": "Costo de ventas {{number}}",
    "source": {
      "entity": "costing.cogs",
      "id": "$.cogsId"
    },
    "lines": [
      {
        "role": "cogs",
        "side": "debit",
        "forEach": "$.lines[*]",
        "amount": "$.cost",
        "costCenter": "$.costCenterId"
      },
      {
        "role": "inventory",
        "side": "credit",
        "forEach": "$.lines[*]",
        "amount": "$.cost"
      }
    ],
    "reverseOf": null
  }
}
