{
  "name": "erp-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "test": "vitest run",
    "test:integration": "turbo run test:integration --concurrency=1",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "check:rules": "tsx scripts/check-rules.ts",
    "db:reset": "supabase db reset",
    "db:migrate:new": "tsx scripts/new-migration.ts",
    "help:index": "tsx scripts/help-index.ts",
    "docker:env": "tsx scripts/docker-env.ts",
    "docker:up": "docker compose --env-file .env.docker up -d --build --wait",
    "docker:down": "docker compose --env-file .env.docker down -v"
  },
  "devDependencies": {
    "@erp/agent": "workspace:*",
    "@erp/kernel": "workspace:*",
    "@erp/module-core": "workspace:*",
    "@erp/module-support": "workspace:*",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
